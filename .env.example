# =============================================================================
# AC215-TarAIntino-Big - Environment Variables Template
# Copy this file to .env and fill in your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# Google Cloud Configuration
# -----------------------------------------------------------------------------
# Path to your Google Cloud service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./secrets/llm-service-account.json

# Google Cloud Storage bucket name for storing generated outputs
GCS_BUCKET_NAME=tarantaino-output

# Google Cloud project ID
GCP_PROJECT_ID=your-project-id

# -----------------------------------------------------------------------------
# Pipeline Configuration (for pipeline2.py orchestration)
# -----------------------------------------------------------------------------
# Service URLs (adjust if running services on different hosts/ports)
QUIZ_SERVICE_URL=http://localhost:8082
SCREENPLAY_SERVICE_URL=http://localhost:8080
SCENE_DECOMPOSER_URL=http://localhost:8001
VIDEO_GENERATOR_URL=http://localhost:8003

# Pipeline timeout in seconds (video generation can take 5-15 minutes)
PIPELINE_TIMEOUT=900

# -----------------------------------------------------------------------------
# Optional: Development Settings
# -----------------------------------------------------------------------------
# Set to 'development' or 'production'
ENVIRONMENT=development

# Enable debug logging (true/false)
DEBUG=false
