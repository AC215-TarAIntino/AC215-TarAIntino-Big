# Required - OpenRouter API Key
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=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

# Optional - Model Selection
# Default: anthropic/claude-3.5-sonnet (recommended for best results)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional - API Configuration
API_HOST=0.0.0.0
API_PORT=8001

# Optional - Generation Defaults
DEFAULT_TRAILER_DURATION=35
INCLUDE_NARRATION=true
