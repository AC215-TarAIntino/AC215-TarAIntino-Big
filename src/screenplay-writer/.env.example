# =============================================================================
# Screenplay Writer Service - Environment Variables
# Copy this file to .env and fill in your actual values
# =============================================================================

# Required - OMDb API Key
# Get your free API key from: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# Required - OpenRouter API Key
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional - Model Selection
# Default: google/gemini-3-pro-preview
# Other options: anthropic/claude-3.5-sonnet, meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_MODEL=google/gemini-3-pro-preview

# Optional - API Configuration
API_HOST=0.0.0.0
API_PORT=8000
